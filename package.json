    "review:submissions": "node scripts/review-submissions.ts"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@vercel/blob": "2.8.2",
    "framer-motion": "^13.4.4",
    "next": "16.4.0-canary.47",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@types/yauzl": "3.4.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0-canary.47",
    "typescript": "^5"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.7"
    },
    "sharp": "0.35.5"
  }
