{
  "name": "ai-design-study-gallery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test lib/*.test.ts scripts/*.test.mjs",
    "validate:submissions": "node scripts/validate-submissions.mjs",
    "deploy:projects": "node scripts/deploy-projects.mjs",
